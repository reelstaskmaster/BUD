TELEGRAM_BOT_TOKEN=123456:replace-me
OPENAI_API_KEY=sk-replace-me
# Optional comma-separated pools. Keep secrets only in Railway/environment variables.
OPENAI_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# Compose overrides this to talk to the db service. Keep only for local runs without Docker.
# DATABASE_URL=postgresql+asyncpg://telegpt:telegpt@localhost:5433/telegpt

AI_CHAIN=gemini,openrouter,openai
GEMINI_CHAT_MODEL=gemini-3.8-flash
OPENROUTER_CHAT_MODEL=openrouter/free

CHAT_MODEL=gpt-4.1
EXTRACT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
IMAGE_MODEL=gpt-image-1

RECENT_MESSAGES=16
FACT_TOP_K=10
FACT_ALL_THRESHOLD=30
SUMMARIZE_EVERY=20
COALESCE_DEBOUNCE_MS=700
EMBEDDING_DIMS=1536
