TELEGRAM_BOT_TOKEN=123456:replace-me
OPENAI_API_KEY=sk-replace-me
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FREELLMAPI_API_KEY=
FREELLMAPI_ENCRYPTION_KEY=generate-a-64-char-hex-key
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Compose overrides this to talk to the db service. Keep only for local runs without Docker.
# DATABASE_URL=postgresql+asyncpg://telegpt:telegpt@localhost:5433/telegpt

AI_CHAIN=gemini,freellmapi,openrouter,openai
GEMINI_CHAT_MODEL=gemini-3.8-flash
OPENROUTER_CHAT_MODEL=openrouter/free
FREELLMAPI_CHAT_MODEL=auto

CHAT_MODEL=gpt-4.1
EXTRACT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
IMAGE_MODEL=gpt-image-1

RECENT_MESSAGES=16
FACT_TOP_K=10
FACT_ALL_THRESHOLD=30
SUMMARIZE_EVERY=20
COALESCE_DEBOUNCE_MS=700
EMBEDDING_DIMS=1536
AI_REQUEST_TIMEOUT_S=60
AI_MAX_TOOL_ROUNDS=8
