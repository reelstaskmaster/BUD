# Copy to .env and fill the secrets. Never commit the real .env.
POSTGRES_USER=telegpt
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=telegpt

TELEGRAM_BOT_TOKEN=123456:replace-me

# Configure only the providers you actually use.
OPENAI_API_KEY=
OPENAI_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

AI_CHAIN=freellmapi,gemini
FREELLMAPI_CHAT_MODEL=auto
FREELLMAPI_EMBEDDING_MODEL=llama-nemotron-embed-vl-1b-v2
FREELLMAPI_STT_MODEL=auto
FREELLMAPI_IMAGE_MODEL=auto
OPENROUTER_CHAT_MODEL=openrouter/free
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

RECENT_MESSAGES=16
FACT_TOP_K=10
FACT_ALL_THRESHOLD=30
SUMMARIZE_EVERY=20
COALESCE_DEBOUNCE_MS=700
EMBEDDING_DIMS=2048

CLAUDEX_ENABLED=true
CLAUDEX_REVIEWER_PROVIDER=gemini
CLAUDEX_REVIEWER_MODEL=
CLAUDEX_MAX_REVIEW_ROUNDS=2

NEEDLE_ENABLED=true
NEEDLE_CONFIDENCE_THRESHOLD=0.35

# Keep MCP empty until each server is audited and explicitly approved.
MCP_ENABLED=true
MCP_SERVERS_JSON=
MCP_TIMEOUT_S=30
MCP_MAX_OUTPUT_CHARS=20000
MCP_STDIO_ALLOWED_COMMANDS=
